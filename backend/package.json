{
  "name": "outbox-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "dev:worker": "node --env-file=.env --import tsx --watch src/worker.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "worker": "node --env-file=.env dist/worker.js",
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@elastic/elasticsearch": "^8.17.0",
    "bullmq": "^5.79.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.0",
    "google-auth-library": "^10.0.0",
    "ioredis": "^5.6.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
